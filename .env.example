# ─── ISMAP Environment Variables ───────────────────────────────────────────────
# Copy this file to .env and fill in the values before starting the server.

# REQUIRED: Strong random secret for signing JWTs (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-long-random-string

# OPTIONAL: SQLAlchemy database URL (defaults to local SQLite file)
DATABASE_URL=sqlite:///ismap.db

# ─── Alert Channels (all optional) ─────────────────────────────────────────────

# Slack incoming webhook URL
SLACK_WEBHOOK=

# Telegram bot token + chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email / SMTP (sender address is also used as recipient)
ALERT_EMAIL=
ALERT_EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
